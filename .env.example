# Copy to .env and fill secrets

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Local embeddings (default BGE-M3 via ModelScope in CN)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
# Alternatives:
# EMBEDDING_MODEL=qihoo360/360Zhinao-Embedding-Base
# EMBEDDING_MODEL=moka-ai/m3e-base
EMBEDDING_DOWNLOAD=modelscope
EMBEDDING_DEVICE=cpu
# EMBEDDING_DIM=1024  # auto from model name if omitted

# PostgreSQL (docker compose: user/password/db = airline)
DATABASE_URL=postgresql://airline:airline@localhost:5432/airline

# HTTPS 部署时置 1，使会话 cookie 仅经 TLS 传输；本地 HTTP 调试保持 0
# COOKIE_SECURE=0

# 多用户部署保持默认关闭；仅单用户/本地调试时置 true 并设置 AIRLINE_SESSION_USERNAME
# AIRLINE_USE_MCP_TOOLS=false

# App demo users (db/seed.sql): zhangsan / lisi / admin — password demo123
